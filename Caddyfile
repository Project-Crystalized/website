# override the domain with the SITE_DOMAIN env var, e.g.
# Usage: 
# when local testing: ```SITE_DOMAIN=:8080 caddy run```
# Serve from the directory this Caddyfile lives in.
{$SITE_DOMAIN:crystalized.cc} {
    encode gzip zstd  # compress text responses (HTML, CSS) to reduce transfer size

    header {
        X-Content-Type-Options "nosniff"                       # prevent MIME-type sniffing
        Content-Security-Policy "frame-ancestors *"              # allow embedding on any site
        Referrer-Policy "strict-origin-when-cross-origin"      # limit referrer data on cross-origin links
    }

    templates           # process {{include}} directives in HTML files
    file_server browse  # serve static files, show directory listings
}
